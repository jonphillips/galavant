#!/bin/sh
# Keeps the XcodeGen project in step with project.yml and the source tree after a checkout,
# merge, or rebase, so a pull that adds or removes a file doesn't leave Xcode on a stale
# project. Called by post-checkout, post-merge, and post-rewrite.
# Enable on a fresh clone with:  git config core.hooksPath .githooks
#
# `--use-cache` regenerates only when the spec or the source file list changed, so running
# on every checkout is cheap. A post-* hook can't undo the operation, so this never fails it.

[ -f project.yml ] || exit 0

if ! command -v xcodegen >/dev/null 2>&1; then
  echo "xcodegen-sync: xcodegen not found — install it with 'brew install xcodegen', then run 'xcodegen generate'." >&2
  exit 0
fi

if ! xcodegen generate --use-cache --quiet; then
  echo "xcodegen-sync: 'xcodegen generate' failed — fix project.yml and run it by hand." >&2
  exit 0
fi

# A tracked project that changes on regeneration was edited by hand or not regenerated
# before commit. Say so rather than leave an unexplained diff.
if [ -n "$(git status --porcelain -- '*.xcodeproj')" ]; then
  echo "xcodegen-sync: regenerating changed the committed Xcode project — project.yml and the checked-in project disagree. Review and commit the regenerated project." >&2
fi
exit 0
